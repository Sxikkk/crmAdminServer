PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info

# You can use either postgres URI or Npgsql-style connection string:
# postgres://postgres:admin@localhost:5433/CRMAdmin
# Host=localhost;Port=5433;Database=CRMAdmin;Username=postgres;Password=admin
POSTGRES_ADMIN=Host=localhost;Port=5433;Database=CRMAdmin;Username=postgres;Password=admin

ADMIN_SERVICE_KEY_SECRET=change-me-admin-service-key-secret-32chars
ADMIN_SERVICE_KEY_TTL_DAYS=90

JWT_SECRET=change-me-please
JWT_EXPIRES_IN=8h

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@crm-admin.local

MAIN_CRM_CREATE_ORG_URL=http://localhost:5206/api/organizations/create
MAIN_CRM_ORGANIZATIONS_URL=http://localhost:5206/api/organizations/all
MAIN_CRM_CHANGE_TYPE_URL=http://localhost:5206/api/organizations/{id}/change-type
MAIN_CRM_CHANGE_STATUS_URL=http://localhost:5206/api/organizations/{id}/change-status
MAIN_CRM_M2M_TOKEN_URL=http://localhost:5206/api/m2m/token
MAIN_CRM_AUTH_URL=http://localhost:5206/api/auth/login

# Option A: static service token with required claims.
MAIN_CRM_API_TOKEN=

# Option B: legacy login flow to main CRM (kept for compatibility).
MAIN_CRM_SERVICE_LOGIN=
MAIN_CRM_SERVICE_PASSWORD=

# Optional. If set, POST /auth/register requires x-admin-registration-token header.
ADMIN_REGISTRATION_TOKEN=

# Seed admin credentials
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
